# Host (with port) the admin is served on; any other host gets 404 on /admin, /api/admin, /api/auth.
ADMIN_HOST=localhost:43127

# Auth.js (Google login for the admin)
AUTH_SECRET=
AUTH_URL=http://localhost:43127
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ALLOWED_EMAILS=filipemlins@gmail.com,beatrizbisol@gmail.com

# Storage (defaults: ./data and <DATA_DIR>/uploads)
DATA_DIR=
UPLOADS_DIR=

# Postgres (docker-compose.prod.yml reads POSTGRES_PASSWORD from .env for the db service)
DATABASE_URL=postgres://desapega:change-me@localhost:5432/desapega
POSTGRES_PASSWORD=
SEED_ITEMS_PATH=data/items.json

# Photos on Cloudflare R2 (unset = uploads stay in UPLOADS_DIR)
MEDIA_BASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
